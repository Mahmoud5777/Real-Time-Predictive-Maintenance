name: ${COMPOSE_PROJECT_NAME:-lot4-physical-central}
services:
  mqtt-broker:
    image: eclipse-mosquitto:2
    container_name: ${COMPOSE_PROJECT_NAME:-lot4-physical}-mqtt
    restart: unless-stopped
    ports: ["${MQTT_PORT:-1883}:1883"]
    volumes:
      - ../../Real-Time-Predictive-Maintenance/mosquitto/mosquitto.conf:/mosquitto/config/mosquitto.conf:ro
      - lot4_mqtt_data:/mosquitto/data
    networks: [lot4_physical]
  scheduler:
    build:
      context: ../../Real-Time-Predictive-Maintenance
      dockerfile: Dockerfile
    image: lot4-physical-scheduler:local
    container_name: ${COMPOSE_PROJECT_NAME:-lot4-physical}-scheduler
    restart: unless-stopped
    command: [uvicorn, scheduler.main:app, --host, 0.0.0.0, --port, "8000"]
    ports: ["${SCHEDULER_PORT:-8100}:8000"]
    environment:
      MQTT_BROKER_HOST: mqtt-broker
      MQTT_BROKER_PORT: "1883"
      FOG_A_URL: http://${FOG_A_IP:?Set FOG_A_IP}:${FOG_A_PORT:-8101}
      FOG_B_URL: http://${FOG_B_IP:?Set FOG_B_IP}:${FOG_B_PORT:-8102}
      FOG_C_URL: http://${FOG_C_IP:?Set FOG_C_IP}:${FOG_C_PORT:-8103}
      PYTHONPATH: /app
    networks: [lot4_physical]
  prometheus:
    image: prom/prometheus:v3.5.0
    container_name: ${COMPOSE_PROJECT_NAME:-lot4-physical}-prometheus
    restart: unless-stopped
    command: [--config.file=/etc/prometheus/prometheus.yml, --storage.tsdb.path=/prometheus, --storage.tsdb.retention.time=15d, --web.enable-lifecycle]
    ports: ["${PROMETHEUS_PORT:-9090}:9090"]
    volumes:
      - ../config/generated/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ../../Lot4_LAN_Integration/monitoring/alert_rules.yml:/etc/prometheus/alert_rules.yml:ro
      - lot4_prometheus_data:/prometheus
    networks: [lot4_physical]
  blackbox-exporter:
    image: prom/blackbox-exporter:v0.27.0
    container_name: ${COMPOSE_PROJECT_NAME:-lot4-physical}-blackbox
    restart: unless-stopped
    command: [--config.file=/etc/blackbox_exporter/blackbox.yml]
    ports: ["${BLACKBOX_PORT:-9115}:9115"]
    volumes: [../../Lot4_LAN_Integration/monitoring/blackbox.yml:/etc/blackbox_exporter/blackbox.yml:ro]
    networks: [lot4_physical]
  grafana:
    image: grafana/grafana:12.2.0
    container_name: ${COMPOSE_PROJECT_NAME:-lot4-physical}-grafana
    restart: unless-stopped
    ports: ["${GRAFANA_PORT:-3002}:3000"]
    environment:
      GF_SECURITY_ADMIN_USER: ${GRAFANA_ADMIN_USER:-admin}
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD:?Set GRAFANA_ADMIN_PASSWORD in the central role env file}
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_SECURITY_COOKIE_SECURE: "false"
    volumes:
      - lot4_grafana_data:/var/lib/grafana
      - ../../Lot4_LAN_Integration/monitoring/grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ../../Lot4_LAN_Integration/monitoring/grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
      - ../../Lot4_LAN_Integration/monitoring/grafana/dashboards:/var/lib/grafana/dashboards:ro
    networks: [lot4_physical]
networks:
  lot4_physical:
    name: ${COMPOSE_PROJECT_NAME:-lot4-physical}-network
    driver: bridge
volumes:
  lot4_mqtt_data:
    name: ${COMPOSE_PROJECT_NAME:-lot4-physical}-mqtt-data
  lot4_prometheus_data:
    name: ${COMPOSE_PROJECT_NAME:-lot4-physical}-prometheus-data
  lot4_grafana_data:
    name: ${COMPOSE_PROJECT_NAME:-lot4-physical}-grafana-data
