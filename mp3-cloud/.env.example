# --- Base de donnees ---
DATABASE_URL=postgresql+asyncpg://fog:fog@localhost:5432/fog_cloud
POSTGRES_USER=fog
POSTGRES_PASSWORD=fog
POSTGRES_DB=fog_cloud
PGPORT=5432

# --- MQTT (ingestion depuis MP2) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=fog-cloud-ingest
MQTT_QOS=1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
INGEST_TOKEN=change-me-in-env
API_PREFIX=/api/v1

# --- Retention et agregation ---
RAW_RETENTION_DAYS=7
SUMMARY_HOURLY_ENABLED=true
KPI_REFRESH_SECONDS=60
HEARTBEAT_TIMEOUT_SECONDS=15

# --- Observabilite ---
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
