# Central PC (copy to a private .env)
CENTRAL_HOST=192.168.1.10
FOG_A_HOST=192.168.1.21
FOG_B_HOST=192.168.1.22
FOG_C_HOST=192.168.1.23
FOG_A_PORT=8001
FOG_B_PORT=8002
FOG_C_PORT=8003
# Scheduler remote URLs: use actual remote addresses
FOG_A_URL=http://${FOG_A_HOST}:${FOG_A_PORT}
FOG_B_URL=http://${FOG_B_HOST}:${FOG_B_PORT}
FOG_C_URL=http://${FOG_C_HOST}:${FOG_C_PORT}
# Set a strong private password before enabling Grafana
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
