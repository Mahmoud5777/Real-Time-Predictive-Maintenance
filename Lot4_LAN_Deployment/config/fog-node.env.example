# Copy to .env on each Fog computer; customize per machine
FOG_ID=fog-a
FOG_ZONE=zone-a
FOG_HOST_PORT=8001
FOG_CONTAINER_PORT=8001
FOG_IMAGE=replace-with-existing-project-fog-image
CENTRAL_HOST=192.168.1.10
MQTT_BROKER_HOST=${CENTRAL_HOST}
MQTT_BROKER_PORT=1883
# Optional HTTP callback/MP3 settings if supported by existing node:
MP3_API_URL=http://${CENTRAL_HOST}:8000
