# Copier en .env et définir un secret aléatoire unique avant de démarrer Grafana.
# Génération PowerShell : $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
PROMETHEUS_CONFIG_FILE=prometheus-local.yml
